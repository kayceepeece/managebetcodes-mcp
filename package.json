{
  "name": "@managebetcodes/mcp",
  "version": "1.0.2",
  "description": "Official Model Context Protocol (MCP) server for Manage Bet Codes API v1",
  "license": "MIT",
  "author": "Manage Bet Codes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kayceepeece/managebetcodes-mcp.git"
  },
  "homepage": "https://managebetcodes.app/mcp",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
